cctz: take the Windows local time zone path (WinRT Windows.Globalization)
only when the MinGW headers have windows.globalization.h. zig 0.17.1's
MinGW headers define NTDDI_WIN10_NI but ship no windows.globalization.h,
so the include fails. Without it, absl::LocalTimeZone() uses TZ, else
UTC, as on MinGW SDKs before NTDDI_WIN10_NI.

--- a/absl/time/internal/cctz/src/time_zone_lookup.cc
+++ b/absl/time/internal/cctz/src/time_zone_lookup.cc
@@ -40,7 +40,8 @@
 // MinGW did not add it until NTDDI_WIN10_NI (SDK version 10.0.22621.0).
 #if ((defined(_WIN32_WINNT_WIN10) && !defined(__MINGW32__)) ||        \
      (defined(NTDDI_WIN10_NI) && NTDDI_VERSION >= NTDDI_WIN10_NI)) && \
-    (_WIN32_WINNT >= _WIN32_WINNT_WINXP)
+    (_WIN32_WINNT >= _WIN32_WINNT_WINXP) && \
+    (!defined(__MINGW32__) || __has_include(<windows.globalization.h>))
 #define USE_WIN32_LOCAL_TIME_ZONE
 #include <roapi.h>
 #include <tchar.h>
